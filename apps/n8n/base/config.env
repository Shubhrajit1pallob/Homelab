# n8n settings shared by every tenant (ConfigMap n8n-config; the tenant's config.env adds its URLs). Names
# checked against the n8n docs for 2.43 (docs.n8n.io, "Environment variables"). Secrets are NOT here.

# Database: the CNPG Cluster's read-write Service in the same namespace. User and password come from the
# Secret n8n-db-app (see n8n-deployment.yaml).
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=n8n-db-rw
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n

N8N_PORT=5678
# The public URL is https (TLS ends at Cloudflare), even though n8n itself serves plain HTTP.
N8N_PROTOCOL=https
# Traefik is the only proxy whose headers reach n8n: it doesn't trust incoming X-Forwarded-* headers (no
# forwardedHeaders.trustedIPs in K3s's Traefik), so it replaces them with its own peer, cloudflared. One hop.
N8N_PROXY_HOPS=1

GENERIC_TIMEZONE=America/New_York
TZ=America/New_York

# Keep 7 days (168 hours) or 10000 executions, whichever is smaller.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

N8N_METRICS=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# The 2.x defaults, set explicitly: workflows can't read env vars (so not the DB password), and the settings
# file is kept at 0600.
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
# Execution files go to /home/node/.n8n/binaryData on the PVC, not into Postgres.
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Task runners (Code node) in EXTERNAL mode: Code node scripts run in the separate task-runners container of the
# same pod (n8n-deployment.yaml), which never sees the DB password or the encryption key. n8n's docs call the
# default internal mode (a child process of n8n) "insecure by design" and deprecate it. The broker keeps its
# default 127.0.0.1:5679, which the sidecar reaches over the pod's localhost. N8N_RUNNERS_ENABLED is deprecated
# in 2.x and not set.
N8N_RUNNERS_MODE=external
