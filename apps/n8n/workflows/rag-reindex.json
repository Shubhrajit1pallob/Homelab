        "parameters": {
          "jsCode": "const posts = $('POST document').all().map(i => i.json);\nconst count = s => posts.filter(p => p.status === s).length;\nconst failed = posts.filter(p => !p.status).map(p => p.document_id || JSON.stringify(p.error || p).slice(0, 200));\n\nconst plan = $('Plan deletes').all().map(i => i.json);\nlet deleted = [], deleteFailed = [];\nif ($('DELETE document').isExecuted) {\n  for (const d of $('DELETE document').all().map(i => i.json)) {\n    if (d.document_id) deleted.push(d.document_id);\n    else if (String(d.error?.httpCode ?? d.error?.message ?? '').includes('404')) deleted.push('(already gone)');\n    else deleteFailed.push(JSON.stringify(d.error || d).slice(0, 200));\n  }\n}\nconst tooMany = plan[0]?.tooMany === true;\n\n// Save state only if everything succeeded, so a half-failed run retries next time\nif (failed.length === 0 && deleteFailed.length === 0) {\n  $getWorkflowStaticData('global').documentIds =\n    $('Get documents').last().json.documents.map(d => d.document_id);\n}\n\nconst s = {\n  oldTag: $('Content Changed?').first().json.oldTag,\n  newTag: $('Content Changed?').first().json.newTag,\n  created: count('created'), content_updated: count('content_updated'),\n  metadata_updated: count('metadata_updated'), unchanged: count('unchanged'),\n  deleted, failed, deleteFailed,\n  skippedDeletes: tooMany ? plan[0].removed : [],\n};\ns.report = s.created + s.content_updated + s.metadata_updated + deleted.length\n         + failed.length + deleteFailed.length + s.skippedDeletes.length > 0;\nreturn [{ json: s }];"
