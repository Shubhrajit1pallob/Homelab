# Non-secret settings for rag-api (app/config.py reads them as env vars; names are case-insensitive).
# kustomization.yaml turns this file into ConfigMap rag-api-config-<content hash> (configMapGenerator), and
# rewrites the Deployment's configMapRef to match. Any edit here changes the name, so the Deployment rolls
# out new pods on its own; no manual restart. ArgoCD prunes the old ConfigMap.
# Format: one KEY=value per line, no quotes (they would become part of the value), no multi-line values.
# The secrets (RAG_QUERY_API_KEY, RAG_ADMIN_API_KEY, VOYAGE_API_KEY, ANTHROPIC_API_KEY, DATABASE_URL) live in
# Secret rag-api-secrets, SOPS-encrypted in secrets/rag-api-secrets.enc.yaml (see the header of deployment.yaml).

VOYAGE_EMBEDDING_MODEL=voyage-3
# Must match the vector(N) column in the rag-api repo's db/schema.sql; changing it means re-embedding.
EMBEDDING_DIMENSIONS=1024
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Supabase session pooler: every open connection counts against the project's pooler limit.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
MAX_CHUNK_SIZE=400
RETRIEVAL_TOP_K=5
MIN_SIMILARITY=0.0
# Spend cap: total /query calls per UTC day across ALL callers. Counted in Postgres (table query_usage), so
# it holds across restarts and replicas; over it, rag-api answers 429. The portfolio's own per-pod daily
# cap (300) sits in front of this one.
DAILY_QUERY_LIMIT=300
# Hard cap on answer length. The chat gives a brief summary and links to the full post/project for detail;
# brevity itself comes from rag-api's system prompt (v0.1.1+). This is only a safety net, so keep it above
# what a 2-4 sentence answer needs, or answers get cut off mid-sentence.
CLAUDE_MAX_TOKENS=250
# Persona for the chat (rag-api v0.1.1+), appended AFTER rag-api's built-in safety and style rules, which take
# priority. Style rules (2-4 sentences, point to the item by title, light Markdown) live in rag-api's code.
ASSISTANT_INSTRUCTIONS=You are the assistant on Shubhrajit Pallob's portfolio site. Speak naturally about his work, in the third person, the way a knowledgeable colleague would introduce it to a recruiter or engineer.
# The portfolio already stops at 400 characters; this is rag-api's own backstop.
MAX_QUESTION_CHARS=500
# Timeout budget: the portfolio's client gives up after 20s. A question is one Voyage call, one Claude call
# and the DB, so the code defaults (20s per call, 1 retry) could run past 40s: the visitor would see an error
# while the answer was still paid for. 8s with no retry keeps the worst case around 16s.
UPSTREAM_TIMEOUT_SECONDS=8
UPSTREAM_MAX_RETRIES=0
