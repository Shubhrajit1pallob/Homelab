.DS_Store

vault/cluster-keys.json
*.json
# n8n workflow exports, sanitized per apps/n8n/workflows/README.md
!apps/n8n/workflows/*.json

# Plaintext secrets - create these in-cluster with kubectl instead
apps/postgres/secrets.yaml

# Terraform (SOC lab AWS side) - state and var files can hold secrets
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# SOPS decrypted/plaintext working copies - never commit
*.dec.yaml
*.plain.yaml
